{
  "name": "edt-blog-builder",
  "private": true,
  "workspaces": [
    "app",
    "functions"
  ],
  "scripts": {
    "templates:clean": "node scripts/clean-templates.mjs",
    "templates:build": "node scripts/build-template-registry.mjs",
    "templates:check": "node scripts/check-templates.mjs",
    "previews:build": "npm run previews:build --workspace functions",
    "emulators": "firebase emulators:start --project demo-edt-blog-builder --import=./.emulator-data --export-on-exit=./.emulator-data",
    "dev:app": "npm run dev --workspace app",
    "dev:functions": "npm run build:watch --workspace functions",
    "dev": "concurrently -n emulators,functions,app -c blue,magenta,green \"npm run emulators\" \"npm run dev:functions\" \"npm run dev:app\"",
    "test": "npm run test --workspace functions"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "firebase-tools": "^15.0.0"
  }
}
