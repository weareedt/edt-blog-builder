<title>Case Study Roundup Template</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Dela+Gothic+One&family=Space+Grotesk:wght@300;400;500;600;700&display=swap');

  :root{
    --blue:#2D2DFF;
    --blue-hover:#0000CC;
    --black:#0A0A0A;
    --surface:#111111;
    --grey:#8C8C8C;
    --white:#FFFFFF;
    --border:#FFFFFF;
    --hairline:rgba(255,255,255,0.14);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--black);
    color:var(--white);
    font-family:'Space Grotesk',sans-serif;
    line-height:1.65;
    -webkit-font-smoothing:antialiased;
  }
  ::selection{background:var(--blue);color:var(--white);}
  h1,h2,h3{margin:0;text-wrap:balance;}
  p{margin:0;}
  a{color:inherit;text-decoration:none;}
  img,svg{display:block;max-width:100%;}
  .wrap{max-width:1180px;margin:0 auto;padding-inline:24px;}
  @media(min-width:900px){.wrap{padding-inline:80px;}}

  .grid-tex{
    position:absolute;inset:0;
    background-image:
      linear-gradient(to right, rgba(255,255,255,0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,0.05) 1px, transparent 1px);
    background-size:32px 32px;
    pointer-events:none;
  }

  /* Header/footer/template-tag are intentionally not part of this output —
     the article is meant to be embedded into the real EDT site/CMS, which
     supplies its own. .btn/.btn-primary/.btn-ghost/.arrow are kept: the
     dynamic CTA section at the bottom still uses them. */
  .btn{
    display:inline-flex;align-items:center;gap:9px;
    font-family:'Space Grotesk',sans-serif;font-weight:600;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;
    padding:13px 22px;border:1px solid var(--blue);
    transition:background 120ms ease,color 120ms ease,transform 120ms ease;
  }
  .btn-primary{background:var(--blue);color:var(--white);}
  .btn-primary:hover{background:var(--blue-hover);transform:scale(1.02);}
  .btn-ghost{background:transparent;border-color:var(--white);}
  .btn-ghost:hover{background:var(--white);color:var(--black);}
  .arrow{transition:transform 120ms ease;display:inline-block;}
  .btn:hover .arrow{transform:translateX(3px);}

  /* ================= BREADCRUMB ================= */
  .crumb-bar{border-bottom:1px solid var(--hairline);}
  .crumb-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 0;font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:var(--grey);}
  .crumb-row a:hover{color:var(--blue);}
  .crumb-row .sep{color:var(--blue);margin:0 8px;}

  /* ================= ARTICLE HERO ================= */
  .article-hero{position:relative;overflow:hidden;padding:56px 0 40px;}
  .eyebrow{
    display:inline-flex;align-items:center;gap:8px;
    font-size:12px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;color:var(--blue);margin-bottom:20px;
  }
  .eyebrow::before{content:"";width:8px;height:8px;background:var(--blue);}
  h1.title{
    font-family:'Dela Gothic One',sans-serif;text-transform:uppercase;letter-spacing:-0.02em;
    font-size:clamp(34px,6vw,68px);line-height:1.02;max-width:18ch;
  }
  .dek{margin-top:24px;max-width:60ch;font-size:clamp(16px,1.8vw,18px);color:#cfcfcf;font-weight:300;}
  .article-meta{
    margin-top:36px;display:flex;flex-wrap:wrap;border-top:1px solid var(--hairline);
  }
  .meta-item{flex:1 1 150px;padding:16px 20px;border-right:1px solid var(--hairline);}
  .meta-item:first-child{padding-left:0;}
  .meta-item:last-child{border-right:none;}
  .meta-item .k{font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:var(--grey);margin-bottom:5px;}
  .meta-item .v{font-size:13px;font-weight:500;}

  .intro{padding:0 0 56px;border-bottom:1px solid var(--hairline);}
  .intro p{max-width:70ch;font-size:17px;color:#dcdcdc;font-weight:300;margin-bottom:18px;}
  .intro p:last-child{margin-bottom:0;}
  .intro a{color:var(--blue);text-decoration:underline;text-underline-offset:3px;}

  /* ================= ROUNDUP LIST ================= */
  .roundup{padding:8px 0 40px;}
  .entry{
    display:grid;grid-template-columns:1fr;gap:32px;
    padding:64px 0;border-bottom:1px solid var(--hairline);
  }
  @media(min-width:860px){
    .entry{grid-template-columns:1fr 1fr;gap:64px;align-items:center;}
    .entry.flip .media{order:2;}
    .entry.flip .copy{order:1;}
    /* No photo for this entry: the media column is omitted entirely
       (guarded further down, per-entry) rather than left as an empty
       frame, so the copy column takes the full row instead of leaving
       a blank second column. */
    .entry.no-media{grid-template-columns:1fr;}
    .entry.no-media .copy{max-width:70ch;}
  }
  .index{
    font-family:'Dela Gothic One',sans-serif;font-size:13px;color:var(--blue);
    letter-spacing:0.06em;margin-bottom:20px;display:block;
  }
  .copy h2{
    font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(22px,2.6vw,30px);margin-bottom:18px;
  }
  .tag-row{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px;}
  .tag{border:1px solid var(--border);font-size:10px;letter-spacing:0.08em;text-transform:uppercase;padding:4px 9px;color:var(--grey);}
  .tag.blue{border-color:var(--blue);color:var(--blue);}
  .copy p.blurb{font-size:15px;color:#c9c9c9;font-weight:300;max-width:58ch;margin-bottom:22px;}
  .stat-line{
    display:flex;align-items:baseline;gap:8px;font-family:'Space Grotesk',sans-serif;
    font-size:13px;color:var(--white);font-weight:600;
  }
  .stat-line::before{content:"→";color:var(--blue);font-weight:700;}

  /* ---- media / autoplay-on-scroll slot ---- */
  .media{position:relative;}
  .os-window{border:1px solid var(--border);background:var(--surface);}
  .os-titlebar{
    display:flex;align-items:center;justify-content:space-between;background:var(--blue);
    padding:11px 16px;border-bottom:1px solid var(--border);
  }
  .os-titlebar .name{font-size:11px;font-weight:600;letter-spacing:0.05em;}
  .os-btns{display:flex;gap:5px;}
  .os-btns i{width:10px;height:10px;border:1px solid var(--white);display:block;}
  .stage{
    position:relative;aspect-ratio:4/3;overflow:hidden;
    background:radial-gradient(circle at 25% 20%, rgba(45,45,255,0.28), transparent 55%), #0d0d0d;
  }
  .stage .thumb{
    position:absolute;inset:0;width:100%;height:100%;object-fit:cover;
    filter:grayscale(.3) contrast(1.15) brightness(.82) saturate(.9);
    transform:scale(1);transition:transform 6s cubic-bezier(.19,1,.22,1);
  }
  .entry.is-playing .stage .thumb{transform:scale(1.08);}
  .stage .tint{position:absolute;inset:0;background:var(--blue);opacity:.24;mix-blend-mode:multiply;}
  .stage .vignette{position:absolute;inset:0;background:linear-gradient(180deg, rgba(0,0,0,0) 45%, rgba(0,0,0,.8) 100%);}
  .stage .scan{
    position:absolute;inset:0;
    background-image:
      linear-gradient(to right, rgba(255,255,255,0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,0.05) 1px, transparent 1px);
    background-size:24px 24px;
  }
  .glyph{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:96px;height:96px;opacity:.9;}
  @media (prefers-reduced-motion: reduce){.stage .thumb{transition:none;}}

  /* ================= CTA ================= */
  .cta{padding:88px 0;border-top:1px solid var(--hairline);}
  .cta h2{font-family:'Dela Gothic One',sans-serif;text-transform:uppercase;font-size:clamp(28px,5vw,48px);letter-spacing:-0.02em;max-width:16ch;margin-bottom:18px;}
  .cta p{color:var(--grey);font-size:16px;max-width:52ch;margin-bottom:32px;font-weight:300;}
  .cta-btns{display:flex;flex-wrap:wrap;gap:16px;}
</style>

<div class="crumb-bar">
  <div class="wrap crumb-row">
    <div><a href="#">Blog</a><span class="sep">/</span><a href="#">{{category}}</a></div>
  </div>
</div>

<section class="article-hero">
  <div class="grid-tex" style="opacity:.5"></div>
  <div class="wrap" style="position:relative;">
    <div class="eyebrow">EDT Blog — Case study roundup</div>
    <h1 class="title">{{title}}</h1>
    <p class="dek">{{dek}}</p>
    <div class="article-meta">
      <div class="meta-item"><div class="k">Category</div><div class="v">{{category}}</div></div>
      <div class="meta-item"><div class="k">Read time</div><div class="v">{{readTimeLabel}}</div></div>
      <div class="meta-item"><div class="k">Format</div><div class="v">{{formatLabel}}</div></div>
      <div class="meta-item"><div class="k">Published</div><div class="v">EDT Blog</div></div>
    </div>
  </div>
</section>

{{#if intro}}
<section class="intro">
  <div class="wrap">
    <p>{{intro}}</p>
  </div>
</section>
{{/if}}

{{#if (eq galleryPlacement "after-intro")}}
{{{galleryHtml}}}
{{/if}}

<section class="roundup" id="roundup-list">
  <div class="wrap">

  {{#each entries}}
  <article class="entry{{#if this.isFlip}} flip{{/if}}{{#unless this.src}} no-media{{/unless}}" data-entry>
    {{#if this.src}}
    <div class="media">
      <div class="os-window">
        <div class="os-titlebar"><span class="name">{{this.windowLabel}}</span><div class="os-btns"><i></i><i></i><i></i></div></div>
        <div class="stage">
          <img class="thumb" src="{{{this.src}}}" alt="{{this.imageAlt}}">
          <div class="scan"></div><div class="tint"></div><div class="vignette"></div>
        </div>
      </div>
    </div>
    {{/if}}
    <div class="copy">
      <span class="index">{{this.indexLabel}}</span>
      <h2>{{this.projectName}}</h2>
      <div class="tag-row">
        <span class="tag blue">{{this.category}}</span>
        {{#if this.client}}<span class="tag">Client — {{this.client}}</span>{{/if}}
      </div>
      <p class="blurb">{{this.blurb}}</p>
      <div class="stat-line">{{this.statLine}}</div>
    </div>
  </article>
  {{/each}}

  </div>
</section>

{{#if (eq galleryPlacement "end-of-article")}}
{{{galleryHtml}}}
{{/if}}

{{#if cta}}
<section class="cta">
  <div class="wrap">
    <h2>{{cta.heading}}</h2>
    <p>{{cta.body}}</p>
    <div class="cta-btns">
      <a class="btn btn-primary" href="#">Get a quote<span class="arrow">→</span></a>
      <a class="btn btn-ghost" href="#">See all work<span class="arrow">→</span></a>
    </div>
  </div>
</section>
{{/if}}

<script>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    var entries = document.querySelectorAll('[data-entry]');
    var io = new IntersectionObserver(function(items){
      items.forEach(function(item){
        item.target.classList.toggle('is-playing', item.isIntersecting);
      });
    }, { threshold: 0.4 });
    entries.forEach(function(el){ io.observe(el); });
  }
</script>
