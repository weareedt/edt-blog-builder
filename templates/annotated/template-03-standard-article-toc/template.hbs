<title>Standard Article Template</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Dela+Gothic+One&family=Space+Grotesk:wght@300;400;500;600;700&display=swap');

  :root{
    --blue:#2D2DFF;
    --blue-hover:#0000CC;
    --black:#0A0A0A;
    --surface:#111111;
    --grey:#8C8C8C;
    --white:#FFFFFF;
    --border:#FFFFFF;
    --hairline:rgba(255,255,255,0.14);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--black);
    color:var(--white);
    font-family:'Space Grotesk',sans-serif;
    line-height:1.65;
    -webkit-font-smoothing:antialiased;
  }
  ::selection{background:var(--blue);color:var(--white);}
  h1,h2,h3{margin:0;text-wrap:balance;}
  p{margin:0;}
  a{color:inherit;text-decoration:none;}
  img,svg{display:block;max-width:100%;}
  .wrap{max-width:1180px;margin:0 auto;padding-inline:24px;}
  @media(min-width:900px){.wrap{padding-inline:80px;}}
  @media(min-width:1440px){.wrap{padding-inline:96px;}}

  .grid-tex{
    position:absolute;inset:0;
    background-image:
      linear-gradient(to right, rgba(255,255,255,0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,0.05) 1px, transparent 1px);
    background-size:32px 32px;
    pointer-events:none;
  }

  /* Header/footer are intentionally not part of this output — the article
     is meant to be embedded into the real EDT site/CMS, which supplies its
     own. .btn/.btn-primary/.btn-ghost/.arrow are kept: the dynamic CTA
     section at the bottom still uses them. */
  .btn{
    display:inline-flex;align-items:center;gap:9px;
    font-family:'Space Grotesk',sans-serif;font-weight:600;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;
    padding:13px 22px;border:1px solid var(--blue);
    transition:background 120ms ease,color 120ms ease,transform 120ms ease;
  }
  .btn-primary{background:var(--blue);color:var(--white);}
  .btn-primary:hover{background:var(--blue-hover);transform:scale(1.02);}
  .btn-ghost{background:transparent;border-color:var(--white);}
  .btn-ghost:hover{background:var(--white);color:var(--black);}
  .arrow{transition:transform 120ms ease;display:inline-block;}
  .btn:hover .arrow{transform:translateX(3px);}

  /* ================= CRUMB ================= */
  .crumb-bar{border-bottom:1px solid var(--hairline);}
  .crumb-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-block:14px;font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:var(--grey);}
  .crumb-row .sep{color:var(--blue);margin:0 8px;}

  /* ================= ARTICLE HERO ================= */
  .article-hero{position:relative;overflow:hidden;padding:56px 0 40px;}
  .eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;color:var(--blue);margin-bottom:20px;}
  .eyebrow::before{content:"";width:8px;height:8px;background:var(--blue);}
  h1.title{
    font-family:'Dela Gothic One',sans-serif;text-transform:uppercase;letter-spacing:-0.02em;
    font-size:clamp(32px,6vw,60px);line-height:1.05;max-width:22ch;
  }
  .dek{margin-top:22px;max-width:62ch;font-size:clamp(16px,1.8vw,19px);color:#cfcfcf;font-weight:300;}
  .byline-row{margin-top:32px;display:flex;flex-wrap:wrap;border-top:1px solid var(--hairline);}
  .byline-item{flex:1 1 130px;padding:14px 20px;border-right:1px solid var(--hairline);}
  .byline-item:first-child{padding-left:0;}
  .byline-item:last-child{border-right:none;}
  .byline-item .k{font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:var(--grey);margin-bottom:5px;}
  .byline-item .v{font-size:13px;font-weight:500;}

  /* ================= LAYOUT: BODY + TOC ================= */
  .article-layout{padding:8px 0 32px;}
  .layout-grid{display:grid;grid-template-columns:1fr;gap:48px;}
  @media(min-width:980px){
    .layout-grid{grid-template-columns:190px 1fr;gap:56px;align-items:start;}
  }

  /* ---- TOC ---- */
  .toc-wrap{border:1px solid var(--hairline);background:var(--surface);order:-1;}
  @media(min-width:980px){
    .toc-wrap{position:sticky;top:24px;order:0;}
  }
  .toc-head{
    display:flex;align-items:center;justify-content:space-between;
    padding:12px 16px;border-bottom:1px solid var(--hairline);
  }
  .toc-head span{font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--grey);}
  .toc-list{list-style:none;margin:0;padding:8px 0;}
  .toc-list li{margin:0;}
  .toc-list a{
    display:flex;gap:8px;align-items:baseline;
    padding:9px 14px;font-size:12.5px;line-height:1.4;color:var(--grey);
    border-left:2px solid transparent;transition:color .2s ease, border-color .2s ease;
  }
  .toc-list a .n{font-size:10px;color:var(--grey);flex-shrink:0;}
  .toc-list a:hover{color:var(--white);}
  .toc-list a.active{color:var(--white);border-left-color:var(--blue);background:rgba(45,45,255,0.08);}
  .toc-list a.active .n{color:var(--blue);}
  .toc-progress{height:2px;background:var(--hairline);}
  .toc-progress-bar{height:100%;width:0%;background:var(--blue);transition:width 120ms linear;}

  /* ---- Article body ---- */
  .article-main{min-width:0;}
  .lede{font-size:18px;font-weight:400;color:#e8e8e8;margin-bottom:40px;line-height:1.7;max-width:70ch;}
  .article-section{padding:40px 0;border-top:1px solid var(--hairline);scroll-margin-top:24px;}
  .article-section:first-child{border-top:none;padding-top:0;}
  .article-section h2{
    font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(22px,2.6vw,28px);margin-bottom:18px;
  }
  .article-section p{font-size:16px;color:#d6d6d6;font-weight:300;line-height:1.8;margin-bottom:20px;max-width:70ch;}
  .article-section p:last-child{margin-bottom:0;}
  .article-section ul{margin:0 0 20px;padding-left:0;list-style:none;max-width:70ch;}
  .article-section ul li{
    position:relative;padding-left:22px;margin-bottom:12px;font-size:16px;color:#d6d6d6;font-weight:300;line-height:1.7;
  }
  .article-section ul li::before{content:"→";position:absolute;left:0;color:var(--blue);font-weight:700;}

  /* ---- comparison table ---- */
  .table-scroll{overflow-x:auto;margin:8px 0 28px;border:1px solid var(--hairline);}
  table{width:100%;border-collapse:collapse;min-width:520px;font-size:14px;}
  th,td{padding:14px 16px;text-align:left;border-bottom:1px solid var(--hairline);}
  thead th{
    background:var(--surface);font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:var(--blue);
    font-weight:700;border-bottom:1px solid var(--border);
  }
  tbody td{color:#d6d6d6;font-weight:300;}
  tbody td:first-child{color:var(--white);font-weight:500;}
  tbody tr:last-child td{border-bottom:none;}

  .callout{
    margin:32px 0;padding:20px 24px;border:1px solid var(--blue);background:rgba(45,45,255,0.06);max-width:70ch;
  }
  .callout .label{font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--blue);margin-bottom:8px;display:block;}
  .callout p{margin-bottom:0;color:#e8e8e8;}

  .closing{padding-top:8px;}
  .closing p{font-size:16px;color:#d6d6d6;font-weight:300;line-height:1.8;max-width:70ch;}

  /* ================= CTA ================= */
  .cta{padding:88px 0;border-top:1px solid var(--hairline);margin-top:32px;}
  .cta h2{font-family:'Dela Gothic One',sans-serif;text-transform:uppercase;font-size:clamp(28px,5vw,48px);letter-spacing:-0.02em;max-width:16ch;margin-bottom:18px;}
  .cta p{color:var(--grey);font-size:16px;max-width:52ch;margin-bottom:32px;font-weight:300;}
  .cta-btns{display:flex;flex-wrap:wrap;gap:16px;}
</style>

<div class="crumb-bar">
  <div class="wrap crumb-row">
    <div><a href="#">Blog</a><span class="sep">/</span><a href="#">{{category}}</a></div>
  </div>
</div>

<section class="article-hero">
  <div class="grid-tex" style="opacity:.5"></div>
  <div class="wrap" style="position:relative;">
    <div class="eyebrow">{{eyebrowText}}</div>
    <h1 class="title">{{title}}</h1>
    <p class="dek">{{dek}}</p>
    <div class="byline-row">
      <div class="byline-item"><div class="k">Author</div><div class="v">{{authorLabel}}</div></div>
      <div class="byline-item"><div class="k">Category</div><div class="v">{{category}}</div></div>
      <div class="byline-item"><div class="k">Read time</div><div class="v">{{readTimeLabel}}</div></div>
      <div class="byline-item"><div class="k">Published</div><div class="v">{{publishedLabel}}</div></div>
    </div>
  </div>
</section>

<section class="article-layout">
  <div class="wrap layout-grid">

    <aside class="toc-wrap">
      <div class="toc-head"><span>On this page</span></div>
      <div class="toc-progress"><div class="toc-progress-bar" id="tocProgress"></div></div>
      <ul class="toc-list" id="tocList">
        {{#each tocSections}}
        <li><a href="#{{this.anchor}}"><span class="n">{{pad2 @index}}</span>{{this.heading}}</a></li>
        {{/each}}
      </ul>
    </aside>

    <div class="article-main">
      <p class="lede">{{lede}}</p>

      {{#each bodyItems}}
      {{#if this.insertHtml}}
      {{{this.insertHtml}}}
      {{else if (eq this.type "section")}}
      <div class="article-section" id="{{this.anchor}}">
        <h2>{{this.heading}}</h2>
        {{#each this.blocks}}
        {{{renderBlock this}}}
        {{/each}}
      </div>
      {{else}}
      {{{renderCallout this}}}
      {{/if}}
      {{/each}}

    </div>
  </div>
</section>

{{#if (eq galleryPlacement "before-cta")}}
{{{galleryHtml}}}
{{/if}}

{{#if cta}}
<section class="cta">
  <div class="wrap">
    <h2>{{cta.heading}}</h2>
    <p>{{cta.body}}</p>
    <div class="cta-btns">
      <a class="btn btn-primary" href="#">Get a quote<span class="arrow">→</span></a>
      <a class="btn btn-ghost" href="#">See our work<span class="arrow">→</span></a>
    </div>
  </div>
</section>
{{/if}}

<script>
  var links = Array.prototype.slice.call(document.querySelectorAll('#tocList a'));
  var sections = links.map(function(a){ return document.querySelector(a.getAttribute('href')); });
  var progressBar = document.getElementById('tocProgress');

  function setActive(id){
    links.forEach(function(a){
      a.classList.toggle('active', a.getAttribute('href') === '#' + id);
    });
  }

  // Scroll via scrollIntoView rather than relying on the browser's native
  // same-page anchor navigation: when this article is shown inside a
  // sandboxed preview iframe with only allow-scripts (no allow-same-origin
  // — deliberately, so the frame can't reach into the host page), native
  // fragment navigation is unreliable — it can silently no-op, or in some
  // configurations blank the frame entirely. A direct DOM scroll sidesteps
  // that altogether and works the same standalone or embedded.
  links.forEach(function(a){
    a.addEventListener('click', function(event){
      var target = document.querySelector(a.getAttribute('href'));
      if (!target) return;
      event.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      setActive(target.id);
    });
  });

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if (entry.isIntersecting) setActive(entry.target.id);
      });
    }, { rootMargin: '-15% 0px -70% 0px' });
    sections.forEach(function(s){ if (s) io.observe(s); });
  }

  function updateProgress(){
    var h = document.documentElement;
    var max = h.scrollHeight - h.clientHeight;
    progressBar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%';
  }
  document.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();
</script>
