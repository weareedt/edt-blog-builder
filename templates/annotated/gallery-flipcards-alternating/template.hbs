<style>
  .gallery-wrap{max-width:1180px;margin:0 auto;padding:40px 24px;}
  @media(min-width:900px){.gallery-wrap{padding:56px 80px;}}
  /* Dropped INSIDE an article's text column (.col in the scroll templates,
     .article-main in the TOC one, .roundup in the project roundup) the column
     already supplies the gutter, so
     the wrapper's own max-width and side padding would inset the gallery a
     second time and leave it narrower than the copy beside it. Clear them
     there and let the gallery span the column edge to edge. At page level
     the wrapper keeps them, so it still lines up with the article's .wrap. */
  .col .gallery-wrap,
  .roundup .gallery-wrap,
  .article-main .gallery-wrap{max-width:none;padding-left:0;padding-right:0;}
  /* Optional editorial heading, so a gallery doesn't arrive unannounced. */
  .gallery-intro{margin:0 0 20px;padding-top:18px;border-top:1px solid var(--hairline);}
  .gallery-eyebrow{display:inline-flex;align-items:center;gap:8px;font-family:'Space Grotesk',sans-serif;font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--blue);}
  .gallery-eyebrow::before{content:"";width:8px;height:8px;background:var(--blue);}
  .gallery-intro p{margin-top:8px;max-width:60ch;font-size:15px;color:#cfcfcf;font-weight:300;line-height:1.6;}

  /* ============ FLIP-CARD GALLERY — drop this block into any article ============ */
  /* Composed per card count against the space the gallery actually has
     (a container query, not the viewport — the scroll templates' text column
     is only ~520-650px wide, where 3 across is cramped). An odd card out
     becomes a wide feature card rather than leaving a hole: 5 cards read
     2+2+1, 7 read 3+3+1, 8 read 2+3+3. Two-across cards are narrow, so they
     go square to give the back's text room. (Selectors are `.flip-grid > .flip-card`,
     not `.flip-card`, to outrank the base rule declared further down.) */
  .gallery-wrap{container-type:inline-size;}
  .flip-grid{display:grid;grid-template-columns:1fr;gap:16px;}
  @container (min-width:460px){
    .flip-grid{grid-template-columns:repeat(2,1fr);}
    .flip-grid > .flip-card{aspect-ratio:1/1;}
    .flip-grid--odd > .flip-card:last-child{grid-column:1 / -1;aspect-ratio:21/9;}
  }
  @container (min-width:880px){
    .flip-grid{grid-template-columns:repeat(6,1fr);}
    .flip-grid > .flip-card{grid-column:span 2;aspect-ratio:16/10;}
    .flip-grid--n4 > .flip-card,
    .flip-grid--n5 > .flip-card,
    .flip-grid--n8 > .flip-card:nth-child(-n+2){grid-column:span 3;}
    .flip-grid--odd > .flip-card:last-child{grid-column:span 2;aspect-ratio:16/10;}
    .flip-grid--n5 > .flip-card:last-child,
    .flip-grid--n7 > .flip-card:last-child{grid-column:1 / -1;aspect-ratio:21/9;}
  }

  .flip-card{position:relative;aspect-ratio:16/10;perspective:1200px;cursor:pointer;}
  .flip-inner{position:relative;width:100%;height:100%;transition:transform .6s cubic-bezier(.19,1,.22,1);transform-style:preserve-3d;}
  .flip-card:hover .flip-inner,
  .flip-card.flipped .flip-inner{transform:rotateY(180deg);}
  .flip-face{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;border:1px solid var(--hairline);overflow:hidden;}
  .flip-front img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:grayscale(.2) contrast(1.1) brightness(.82) saturate(.95);}
  .flip-front .tint{position:absolute;inset:0;background:var(--blue);opacity:.2;mix-blend-mode:multiply;}
  .flip-front .scrim{position:absolute;inset:0;background:linear-gradient(180deg, rgba(0,0,0,0) 55%, rgba(0,0,0,.8) 100%);}
  .flip-front .label{position:absolute;left:14px;bottom:14px;right:14px;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:15px;color:var(--white);}
  .flip-front .hint{position:absolute;top:12px;right:12px;width:26px;height:26px;border:1px solid rgba(255,255,255,.5);display:flex;align-items:center;justify-content:center;font-size:12px;color:var(--white);}
  /* Top-aligned, always: with space-between the description jumped to the
     bottom whenever a card had no project line. The project line, when
     present, still pins to the bottom via its own margin-top:auto. */
  .flip-back{transform:rotateY(180deg);background:var(--blue);padding:20px;display:flex;flex-direction:column;justify-content:flex-start;}
  .flip-back .tag{border:0;padding:0;background:none;font-size:10px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:rgba(255,255,255,0.8);}
  .flip-back p{font-size:14px;color:var(--white);font-weight:400;line-height:1.55;margin-top:10px;}
  .flip-back .stack{font-size:11px;color:rgba(255,255,255,0.75);margin-top:auto;padding-top:10px;border-top:1px solid rgba(255,255,255,.25);}
  .flip-front-empty{
    position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;padding:16px;
    background:repeating-linear-gradient(45deg, var(--black), var(--black) 8px, var(--surface) 8px, var(--surface) 16px);
    color:var(--grey);font-family:'Space Grotesk',sans-serif;font-size:10px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;
  }
  @media (prefers-reduced-motion: reduce){.flip-inner{transition:none;}}
</style>

<div class="gallery-wrap">
  {{#if intro}}
  <header class="gallery-intro"><span class="gallery-eyebrow">{{intro.eyebrow}}</span>{{#if intro.line}}<p>{{intro.line}}</p>{{/if}}</header>
  {{/if}}
  <div class="flip-grid {{gridClass}}">
    {{#each items}}
    <div class="flip-card" tabindex="0">
      <div class="flip-inner">
        <div class="flip-face flip-front">
          {{#if this.src}}
          <img src="{{{this.src}}}" alt="{{this.alt}}"><div class="tint"></div><div class="scrim"></div>
          {{else}}
          <div class="flip-front-empty">No photo provided</div>
          {{/if}}
          <span class="hint">↻</span>{{#if this.label}}<div class="label">{{this.label}}</div>{{/if}}
        </div>
        <div class="flip-face flip-back">
          <span class="tag">{{this.indexTag}}</span>
          {{#if this.body}}<p>{{this.body}}</p>{{/if}}
          {{#if this.projectLine}}<div class="stack">{{this.projectLine}}</div>{{/if}}
        </div>
      </div>
    </div>
    {{/each}}
  </div>
</div>

<script>
  document.querySelectorAll('.flip-card').forEach(function(card){
    card.addEventListener('click', function(){ card.classList.toggle('flipped'); });
    card.addEventListener('keydown', function(e){
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); card.classList.toggle('flipped'); }
    });
  });
</script>
