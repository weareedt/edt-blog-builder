<style>
  .gallery-wrap{max-width:1180px;margin:0 auto;padding:40px 24px;}
  @media(min-width:900px){.gallery-wrap{padding:56px 80px;}}

  /* ============ FLIP-CARD GALLERY — drop this block into any article ============ */
  .flip-grid{display:grid;grid-template-columns:1fr;gap:16px;}
  @media(min-width:640px){.flip-grid{grid-template-columns:repeat(2,1fr);}}
  @media(min-width:980px){.flip-grid{grid-template-columns:repeat(3,1fr);}}

  .flip-card{position:relative;aspect-ratio:16/10;perspective:1200px;cursor:pointer;}
  .flip-inner{position:relative;width:100%;height:100%;transition:transform .6s cubic-bezier(.19,1,.22,1);transform-style:preserve-3d;}
  .flip-card:hover .flip-inner,
  .flip-card.flipped .flip-inner{transform:rotateY(180deg);}
  .flip-face{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;border:1px solid var(--hairline);overflow:hidden;}
  .flip-front img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:grayscale(.2) contrast(1.1) brightness(.82) saturate(.95);}
  .flip-front .tint{position:absolute;inset:0;background:var(--blue);opacity:.2;mix-blend-mode:multiply;}
  .flip-front .scrim{position:absolute;inset:0;background:linear-gradient(180deg, rgba(0,0,0,0) 55%, rgba(0,0,0,.8) 100%);}
  .flip-front .label{position:absolute;left:14px;bottom:14px;right:14px;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:15px;color:var(--white);}
  .flip-front .hint{position:absolute;top:12px;right:12px;width:26px;height:26px;border:1px solid rgba(255,255,255,.5);display:flex;align-items:center;justify-content:center;font-size:12px;color:var(--white);}
  .flip-back{transform:rotateY(180deg);background:var(--blue);padding:20px;display:flex;flex-direction:column;justify-content:space-between;}
  .flip-back .tag{font-size:10px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:rgba(255,255,255,0.8);}
  .flip-back p{font-size:14px;color:var(--white);font-weight:400;line-height:1.55;margin-top:10px;}
  .flip-back .stack{font-size:11px;color:rgba(255,255,255,0.75);margin-top:auto;padding-top:10px;border-top:1px solid rgba(255,255,255,.25);}
  .flip-front-empty{
    position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;padding:16px;
    background:repeating-linear-gradient(45deg, var(--black), var(--black) 8px, var(--surface) 8px, var(--surface) 16px);
    color:var(--grey);font-family:'Space Grotesk',sans-serif;font-size:10px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;
  }
  @media (prefers-reduced-motion: reduce){.flip-inner{transition:none;}}
</style>

<div class="gallery-wrap">
  <div class="flip-grid">
    {{#each items}}
    <div class="flip-card" tabindex="0">
      <div class="flip-inner">
        <div class="flip-face flip-front">
          {{#if this.src}}
          <img src="{{{this.src}}}" alt="placeholder"><div class="tint"></div><div class="scrim"></div>
          {{else}}
          <div class="flip-front-empty">No photo provided</div>
          {{/if}}
          <span class="hint">↻</span><div class="label">{{this.label}}</div>
        </div>
        <div class="flip-face flip-back">
          <span class="tag">{{this.indexTag}}</span>
          <p>{{this.body}}</p>
          <div class="stack">{{this.projectLine}}</div>
        </div>
      </div>
    </div>
    {{/each}}
  </div>
</div>

<script>
  document.querySelectorAll('.flip-card').forEach(function(card){
    card.addEventListener('click', function(){ card.classList.toggle('flipped'); });
    card.addEventListener('keydown', function(e){
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); card.classList.toggle('flipped'); }
    });
  });
</script>
