<title>Basic Scroll Article Template</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Dela+Gothic+One&family=Space+Grotesk:wght@300;400;500;600;700&display=swap');

  :root{
    --blue:#2D2DFF;
    --blue-hover:#0000CC;
    --black:#0A0A0A;
    --surface:#111111;
    --grey:#8C8C8C;
    --white:#FFFFFF;
    --border:#FFFFFF;
    --hairline:rgba(255,255,255,0.14);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--black);
    color:var(--white);
    font-family:'Space Grotesk',sans-serif;
    line-height:1.65;
    -webkit-font-smoothing:antialiased;
  }
  ::selection{background:var(--blue);color:var(--white);}
  h1,h2,h3{margin:0;text-wrap:balance;}
  p{margin:0;}
  a{color:inherit;text-decoration:none;}
  img,svg{display:block;max-width:100%;}
  .wrap{max-width:1180px;margin:0 auto;padding-inline:24px;}
  @media(min-width:900px){.wrap{padding-inline:80px;}}
  @media(min-width:1440px){.wrap{padding-inline:96px;}}
  .col{max-width:680px;margin:0 auto;}
  @media(min-width:1440px){.col{max-width:840px;}}

  .grid-tex{
    position:absolute;inset:0;
    background-image:
      linear-gradient(to right, rgba(255,255,255,0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,0.05) 1px, transparent 1px);
    background-size:32px 32px;
    pointer-events:none;
  }

  /* ================= READING PROGRESS ================= */
  .progress-track{position:fixed;top:0;left:0;right:0;height:3px;background:var(--surface);z-index:40;}
  .progress-bar{height:100%;width:0%;background:var(--blue);transition:width 80ms linear;}

  /* Header/footer/template-tag are intentionally not part of this output —
     the article is meant to be embedded into the real EDT site/CMS, which
     supplies its own. .btn/.btn-primary/.btn-ghost/.arrow are kept: the
     dynamic CTA section at the bottom still uses them. */
  .btn{
    display:inline-flex;align-items:center;gap:9px;
    font-family:'Space Grotesk',sans-serif;font-weight:600;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;
    padding:13px 22px;border:1px solid var(--blue);
    transition:background 120ms ease,color 120ms ease,transform 120ms ease;
  }
  .btn-primary{background:var(--blue);color:var(--white);}
  .btn-primary:hover{background:var(--blue-hover);transform:scale(1.02);}
  .btn-ghost{background:transparent;border-color:var(--white);}
  .btn-ghost:hover{background:var(--white);color:var(--black);}
  .arrow{transition:transform 120ms ease;display:inline-block;}
  .btn:hover .arrow{transform:translateX(3px);}

  /* ================= CRUMB ================= */
  .crumb-bar{border-bottom:1px solid var(--hairline);}
  .crumb-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 0;font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:var(--grey);}
  .crumb-row .sep{color:var(--blue);margin:0 8px;}

  /* ================= ARTICLE HERO ================= */
  .article-hero{position:relative;overflow:hidden;padding:56px 0 40px;}
  .eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;color:var(--blue);margin-bottom:20px;}
  .eyebrow::before{content:"";width:8px;height:8px;background:var(--blue);}
  h1.title{
    font-family:'Dela Gothic One',sans-serif;text-transform:uppercase;letter-spacing:-0.02em;
    font-size:clamp(36px,7vw,76px);line-height:1.0;max-width:16ch;
  }
  .dek{margin-top:24px;max-width:56ch;font-size:clamp(17px,1.9vw,20px);color:#cfcfcf;font-weight:300;}
  .byline-row{margin-top:36px;display:flex;flex-wrap:wrap;border-top:1px solid var(--hairline);}
  .byline-item{flex:1 1 140px;padding:16px 20px;border-right:1px solid var(--hairline);}
  .byline-item:first-child{padding-left:0;}
  .byline-item:last-child{border-right:none;}
  .byline-item .k{font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:var(--grey);margin-bottom:5px;}
  .byline-item .v{font-size:13px;font-weight:500;}

  /* ================= FEATURE IMAGE ================= */
  .feature-media{padding:8px 0 64px;}
  .os-window{border:1px solid var(--border);background:var(--surface);}
  .os-titlebar{display:flex;align-items:center;justify-content:space-between;background:var(--blue);padding:11px 16px;border-bottom:1px solid var(--border);}
  .os-titlebar .name{font-size:11px;font-weight:600;letter-spacing:0.05em;}
  .os-btns{display:flex;gap:5px;}
  .os-btns i{width:10px;height:10px;border:1px solid var(--white);display:block;}
  .feature-stage{position:relative;aspect-ratio:16/9;overflow:hidden;}
  .feature-stage img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:grayscale(.25) contrast(1.12) brightness(.85) saturate(.9);}
  .feature-stage .tint{position:absolute;inset:0;background:var(--blue);opacity:.2;mix-blend-mode:multiply;}
  .feature-stage .grid-tex{opacity:.35;}
  .feature-caption{padding:14px 4px 0;font-size:12px;color:var(--grey);}

  /* ================= ARTICLE BODY (flat, no numbered steps) ================= */
  .article-body{padding:0 0 32px;}
  .lede{font-size:19px;font-weight:400;color:#e8e8e8;margin-bottom:36px;line-height:1.7;}
  .section-label{
    display:block;font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;
    color:var(--blue);margin:52px 0 18px;
  }
  .section-label:first-child{margin-top:0;}
  .body-copy p{font-size:17px;color:#d6d6d6;font-weight:300;line-height:1.8;margin-bottom:22px;}
  .body-copy p:last-child{margin-bottom:0;}
  .drop p:first-of-type::first-letter{
    font-family:'Dela Gothic One',sans-serif;color:var(--blue);
    font-size:4.4em;line-height:.72;float:left;padding:5px 10px 0 0;
  }

  [data-reveal]{opacity:0;transform:translateY(22px);transition:opacity .7s ease, transform .7s ease;}
  [data-reveal].revealed{opacity:1;transform:translateY(0);}
  @media (prefers-reduced-motion: reduce){[data-reveal]{opacity:1;transform:none;transition:none;}}

  .pull-quote{margin:56px 0;padding-left:28px;border-left:3px solid var(--blue);}
  .pull-quote p{
    font-family:'Space Grotesk',sans-serif;font-weight:500;font-size:clamp(22px,3vw,30px);
    color:var(--white);line-height:1.4;text-wrap:balance;
  }
  .pull-quote .src{margin-top:14px;font-size:13px;color:var(--grey);}

  .stat-card{margin:56px 0;}
  .stat-card .os-titlebar{background:var(--blue);}
  .stat-grid{display:grid;grid-template-columns:1fr;gap:1px;background:var(--hairline);}
  @media(min-width:560px){.stat-grid{grid-template-columns:1fr 1fr;}}
  .stat-cell{background:var(--surface);padding:28px 24px;}
  .stat-num{font-family:'Dela Gothic One',sans-serif;font-size:clamp(32px,5vw,44px);color:var(--white);}
  .stat-label{margin-top:8px;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:var(--grey);}

  .inline-tags{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0 40px;}
  .tag{border:1px solid var(--border);font-size:10px;letter-spacing:0.08em;text-transform:uppercase;padding:4px 9px;color:var(--grey);}
  .tag.blue{border-color:var(--blue);color:var(--blue);}

  .closing{padding:8px 0 24px;}
  .closing p{font-size:17px;color:#d6d6d6;font-weight:300;line-height:1.8;margin-bottom:22px;}

  /* ================= CTA ================= */
  .cta{padding:88px 0;border-top:1px solid var(--hairline);margin-top:32px;}
  .cta h2{font-family:'Dela Gothic One',sans-serif;text-transform:uppercase;font-size:clamp(28px,5vw,48px);letter-spacing:-0.02em;max-width:16ch;margin-bottom:18px;}
  .cta p{color:var(--grey);font-size:16px;max-width:52ch;margin-bottom:32px;font-weight:300;}
  .cta-btns{display:flex;flex-wrap:wrap;gap:16px;}
</style>

<div class="progress-track"><div class="progress-bar" id="progressBar"></div></div>

<div class="crumb-bar">
  <div class="wrap crumb-row">
    <div><a href="#">Blog</a><span class="sep">/</span><a href="#">Long Read</a></div>
  </div>
</div>

<section class="article-hero">
  <div class="grid-tex" style="opacity:.5"></div>
  <div class="wrap" style="position:relative;">
    <div class="eyebrow">EDT Blog — Long read</div>
    <h1 class="title">{{title}}</h1>
    <p class="dek">{{dek}}</p>
    <div class="byline-row">
      {{#if client}}
      <div class="byline-item"><div class="k">Client</div><div class="v">{{client}}</div></div>
      {{/if}}
      <div class="byline-item"><div class="k">Category</div><div class="v">{{category}}</div></div>
      <div class="byline-item"><div class="k">Read time</div><div class="v">{{readTimeLabel}}</div></div>
      <div class="byline-item"><div class="k">Format</div><div class="v">Long read</div></div>
    </div>
  </div>
</section>

{{#if featureImage}}
{{#if featureImage.src}}
<section class="feature-media">
  <div class="wrap">
    <div class="os-window" data-reveal>
      <div class="os-titlebar"><span class="name">{{featureImage.windowLabel}}</span><div class="os-btns"><i></i><i></i><i></i></div></div>
      <div class="feature-stage">
        <img src="{{{featureImage.src}}}" alt="{{featureImage.caption}}">
        <div class="tint"></div>
        <div class="grid-tex"></div>
      </div>
    </div>
    <p class="feature-caption">{{featureImage.caption}}</p>
  </div>
</section>
{{/if}}
{{/if}}

<section class="article-body">
  <div class="wrap col">
    <p class="lede">{{lede}}</p>

    {{#if (eq galleryPlacement "after-intro")}}
    {{{galleryHtml}}}
    {{/if}}

    {{#each bodyItems}}
    {{#if this.videoHtml}}
    {{{this.videoHtml}}}
    {{else if (eq this.type "section")}}
    <span class="section-label">{{this.sectionLabel}}</span>
    <div class="body-copy{{#if this.isFirstSection}} drop{{/if}}" data-reveal>
      {{#each this.paragraphs}}
      <p>{{this}}</p>
      {{/each}}
    </div>
    {{else}}
    {{{renderHighlight this.highlight}}}
    {{/if}}
    {{/each}}

    {{#if closing}}
    <div class="closing" data-reveal>
      <p>{{closing}}</p>
    </div>
    {{/if}}
  </div>
</section>

{{#if (eq galleryPlacement "before-cta")}}
{{{galleryHtml}}}
{{/if}}

{{#if cta}}
<section class="cta">
  <div class="wrap">
    <h2>{{cta.heading}}</h2>
    <p>{{cta.body}}</p>
    <div class="cta-btns">
      <a class="btn btn-primary" href="#">Get a quote<span class="arrow">→</span></a>
      <a class="btn btn-ghost" href="#">Read more case studies<span class="arrow">→</span></a>
    </div>
  </div>
</section>
{{/if}}

<script>
  var bar = document.getElementById('progressBar');
  function updateProgress(){
    var h = document.documentElement;
    var scrolled = h.scrollTop;
    var max = h.scrollHeight - h.clientHeight;
    bar.style.width = (max > 0 ? (scrolled / max) * 100 : 0) + '%';
  }
  document.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    var targets = document.querySelectorAll('[data-reveal]');
    var io = new IntersectionObserver(function(items){
      items.forEach(function(item){
        if (item.isIntersecting) {
          item.target.classList.add('revealed');
          io.unobserve(item.target);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
    targets.forEach(function(el){ io.observe(el); });
  } else {
    document.querySelectorAll('[data-reveal]').forEach(function(el){ el.classList.add('revealed'); });
  }
</script>
